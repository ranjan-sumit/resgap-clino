# Python runtime for the FastAPI backend and the Streamlit app.
# Deps are baked here; code is bind-mounted at runtime (see docker-compose.yml).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Disable Debian's docker-clean apt hook: its cache-purge step fails under this
# host's older overlay filesystem/kernel combo (unrelated to disk space).
RUN rm -f /etc/apt/apt.conf.d/docker-clean

# Runtime libs some docling/torch transitive wheels expect on slim images
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

# requirements-clinova.txt includes -r requirements.txt and adds fastapi/uvicorn (+docling)
COPY requirements.txt requirements-clinova.txt ./
RUN pip install --no-cache-dir -r requirements-clinova.txt

EXPOSE 8000 8501
