# Clinova Research Intelligence Platform — local environment configuration
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required for any pipeline stage that calls the LLM (wiki compilation, gap detection,
# gap validation, proposal generation, research council). Get a free key at:
# https://build.nvidia.com
NVIDIA_API_KEY=

# Optional. Used for Semantic Scholar reference-enrichment and gap-validation search
# calls (pipeline/academic_search.py, pipeline/reference_extractor.py). Free tier
# available. Calls work unauthenticated too, at a lower rate limit, if left blank.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: Google Gemini (select it in the sidebar's Model Provider dropdown).
GEMINI_API_KEY=

# Optional: where the SQLite database (run history + graph snapshots) lives.
# Default: data/run_history.db
# RESGAP_DB_PATH=

# Optional: more model providers (all OpenAI-compatible). Pick which model does what
# in the app, under Models for this run.
OPENAI_API_KEY=
GROQ_API_KEY=
# Any other OpenAI-compatible endpoint (choose Custom endpoint in the app):
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_API_KEY=
