# Clinova Research Intelligence Platform — local environment configuration
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required for any pipeline stage that calls the LLM (wiki compilation, gap detection,
# gap validation, proposal generation, research council). Get a free key at:
# https://build.nvidia.com
NVIDIA_API_KEY=

# Optional. Used for Semantic Scholar reference-enrichment and gap-validation search
# calls (pipeline/academic_search.py, pipeline/reference_extractor.py). Free tier
# available. Calls work unauthenticated too, at a lower rate limit, if left blank.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: Google Gemini (select it in the sidebar's Model Provider dropdown).
GEMINI_API_KEY=

# Optional: where the SQLite database (run history + graph snapshots) lives.
# Default: data/run_history.db
# RESGAP_DB_PATH=

# Optional: more model providers (all OpenAI-compatible). Pick which model does what
# in the app, under Models for this run.
OPENAI_API_KEY=
GROQ_API_KEY=
# Any other OpenAI-compatible endpoint (choose Custom endpoint in the app):
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_API_KEY=

# Optional. OpenAlex limits keyless use to a small daily budget shared by everyone on your network;
# a free key (https://help.openalex.org/api/authentication/) lifts it. Used to match references.
OPENALEX_API_KEY=

# Optional. A real contact address; lets the app look up open-access links through Unpaywall (it rejects made-up ones).
RESGAP_CONTACT_EMAIL=

# Controlled deployments (see DEPLOY.md, "Controlled environments"). All optional.
# How far the app may reach: open (default) | models (model providers only, no reference or literature look-ups)
# | none (nothing leaves the network except an approved custom endpoint). Any other value means none.
# RESGAP_EGRESS=open
# Which model providers may be used, e.g. gemini,custom. Unset: all of them.
# RESGAP_ALLOWED_PROVIDERS=
# Host names the custom endpoint may use, e.g. llm.corp.example,.internal.example. Required in RESGAP_EGRESS=none unless the endpoint is on this computer.
# RESGAP_ALLOWED_HOSTS=
# 1 = deleting is permanent (folders erased, caches emptied).
# RESGAP_ERASE_ON_DELETE=
# Name recorded in the audit log as the person acting. A sign-in layer or reverse proxy should set this per user. Default: local.
# RESGAP_ACTOR=
