# Next.js frontend. Build context MUST be the repo root:
# next.config.ts sets outputFileTracingRoot to the monorepo root and reads packages/branding.
FROM node:22-alpine AS build
WORKDIR /monorepo
COPY . .

WORKDIR /monorepo/apps/web
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm ci && npm run build

FROM node:22-alpine
ENV NODE_ENV=production \
    API_BASE_URL=http://api:8000 \
    PORT=3000
WORKDIR /monorepo
COPY --from=build /monorepo/apps/web ./apps/web
COPY --from=build /monorepo/packages ./packages
WORKDIR /monorepo/apps/web
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
